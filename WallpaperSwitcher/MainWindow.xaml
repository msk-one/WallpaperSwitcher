<Window x:Class="WallpaperSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WallpaperSwitcher"
        mc:Ignorable="d"
        Title="Wallpaper Switcher"
        Height="680"
        Width="940"
        MinHeight="620"
        MinWidth="860"
        Background="#F4EFE7">
    <Window.Resources>
        <x:Array x:Key="WallpaperCategories" Type="{x:Type local:WallpaperCategory}">
            <local:WallpaperCategory>Ignore</local:WallpaperCategory>
            <local:WallpaperCategory>Day</local:WallpaperCategory>
            <local:WallpaperCategory>Night</local:WallpaperCategory>
        </x:Array>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Margin="0,0,0,14"
                Background="#FCFAF6"
                BorderBrush="#D9D0C4"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontFamily="Segoe UI Semibold"
                               FontSize="22"
                               Foreground="#2F241C"
                               Text="Wallpaper Switcher" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#6A5A4C"
                               Text="Point to one folder, mark each image as Day or Night, and let the app handle the rest from the system tray." />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="104"
                        Height="36"
                        Margin="16,0,0,0"
                        Click="ApplyNow_Click"
                        Background="#2F6B5C"
                        BorderBrush="#2F6B5C"
                        Foreground="White"
                        Content="Apply now" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Margin="0,0,10,0"
                    Background="#FCFAF6"
                    BorderBrush="#D9D0C4"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="#4B3F34"
                               FontFamily="Segoe UI Semibold"
                               Text="Wallpaper folder" />
                    <TextBox Grid.Column="1"
                             Margin="12,0,10,0"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Text="{Binding WallpaperDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2"
                            Width="86"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="BrowseFolder_Click"
                            Content="Browse" />
                    <Button Grid.Column="3"
                            Width="86"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RefreshFolder_Click"
                            Content="Refresh" />
                    <Button Grid.Column="4"
                            Width="86"
                            Height="34"
                            Click="Save_Click"
                            Content="Save" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,10,0,0"
                               Foreground="#7B6C5D"
                               Text="Supported files: .jpg, .jpeg, .png, .bmp" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="16"
                    Margin="10,0,0,0"
                    Background="#FCFAF6"
                    BorderBrush="#D9D0C4"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="#4B3F34"
                               FontFamily="Segoe UI Semibold"
                               Text="Day starts" />
                    <TextBox Grid.Column="1"
                             Margin="10,0,14,0"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Text="{Binding DayStartText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#4B3F34"
                               FontFamily="Segoe UI Semibold"
                               Text="Night starts" />
                    <TextBox Grid.Column="3"
                             Margin="10,0,0,0"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Text="{Binding NightStartText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="#4B3F34"
                               FontFamily="Segoe UI Semibold"
                               Text="Shuffle" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="3"
                              Margin="10,12,0,0"
                              Height="34"
                              ItemsSource="{Binding ShuffleOptions}"
                              SelectedItem="{Binding SelectedShuffleOption}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="0"
                Background="#FCFAF6"
                BorderBrush="#D9D0C4"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="16,16,16,10">
                    <TextBlock FontFamily="Segoe UI Semibold"
                               FontSize="15"
                               Foreground="#2F241C"
                               Text="Image assignments" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#7B6C5D"
                               Text="Images with 'day' or 'night' in the file name are pre-tagged automatically. Everything else starts as Ignore." />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Margin="16,0,16,16"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          ItemsSource="{Binding WallpaperItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File"
                                            Width="220"
                                            Binding="{Binding FileName}"
                                            IsReadOnly="True" />
                        <DataGridComboBoxColumn Header="Use As"
                                                Width="130"
                                                SelectedItemBinding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding Source={StaticResource WallpaperCategories}}" />
                        <DataGridTextColumn Header="Path"
                                            Width="*"
                                            Binding="{Binding FullPath}"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="#5C4D40"
                       Text="{Binding StatusMessage}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#7B6C5D"
                       Text="{Binding SettingsPath}" />
        </Grid>
    </Grid>
</Window>
